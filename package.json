{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "description": "AgentForge - Multi-Agent AI System Builder",
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "lint:fix": "npm run lint:fix --workspace=frontend",
    "format": "npm run format --workspace=frontend",
    "format:check": "npm run format:check --workspace=frontend",
    "type-check": "npm run type-check --workspace=frontend",
    "prepare": "husky"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "npm run lint:fix --workspace=frontend --",
      "prettier --write"
    ],
    "frontend/src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
